# Copy to `.env` for local `vercel dev`, and set the same keys in the Vercel
# project dashboard (Settings -> Environment Variables) for production.

# GitHub OAuth App (https://github.com/settings/developers -> New OAuth App)
#   Homepage URL:               https://gearonixx.github.io/study/
#   Authorization callback URL: https://<your-api>.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ byte secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Neon Postgres connection string (Vercel -> Storage -> Neon gives you this).
DATABASE_URL=

# The exact origin of the frontend, used for CORS and to validate the OAuth
# return URL. No trailing slash, no path.
ALLOWED_ORIGIN=https://gearonixx.github.io
